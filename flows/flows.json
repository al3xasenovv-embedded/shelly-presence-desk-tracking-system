    {
        "id": "487ccae60bb6a13c",
        "type": "function",
        "z": "fb8178f3789d4b3d",
        "name": "Format Session Summary",
        "func": "if (msg.payload.event_type === 'session_end') {\n    var satMin = Math.floor(msg.payload.total_sat_seconds / 60);\n    var satSec = msg.payload.total_sat_seconds % 60;\n    var stoodMin = Math.floor(msg.payload.total_stood_seconds / 60);\n    var stoodSec = msg.payload.total_stood_seconds % 60;\n\n    msg.payload = `Sat: ${satMin}m ${satSec}s | Stood: ${stoodMin}m ${stoodSec}s`;\n} else {\n    msg.payload = 'Session in progress...';\n}\nreturn msg;",
