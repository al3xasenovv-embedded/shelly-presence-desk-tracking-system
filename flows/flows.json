    {
        "id": "3579f20b135b643b",
        "type": "function",
        "z": "fb8178f3789d4b3d",
        "name": "Calculate Elapsed",
        "func": "const sessionActive = flow.get('sessionActive') || false;\n\nif (!sessionActive) {\n    msg.payload = 'No active session';\n    return msg;\n}\n\nconst lastChange = flow.get('lastChangeTime') || Date.now();\nconst deskState = flow.get('deskState') || 'unknown';\n\nconst elapsedMs = Date.now() - lastChange;\nconst totalSeconds = Math.floor(elapsedMs / 1000);\nconst minutes = Math.floor(totalSeconds / 60);\nconst seconds = totalSeconds % 60;\n\nmsg.payload = `${deskState} for ${minutes}m ${seconds}s`;\nreturn msg;",
