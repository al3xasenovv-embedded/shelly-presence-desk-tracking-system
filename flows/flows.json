    {
        "id": "cf724aa7198e9785",
        "type": "function",
        "z": "fb8178f3789d4b3d",
        "name": "Session Logic ",
        "func": "// локално време (Europe/Sofia) като ISO низ БЕЗ Z — Postgres го записва буквално\nfunction localISO(ms) {\n    var d = new Date(ms);\n    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, -1);\n}\n\nvar sessionActive = flow.get('sessionActive') || false;\nvar statusMsg;\nvar insertMsg;\n\nif (!sessionActive) {\n    // СТАРТ на сесия\n    var startTime = Date.now();\n    flow.set('sessionActive', true);\n    flow.set('sessionStartTime', startTime);\n    flow.set('lastChangeTime', startTime);\n    flow.set('sessionSatSeconds', 0);\n    flow.set('sessionStoodSeconds', 0);\n    flow.set('deskState', 'sat');\n\n    msg.payload = {\n        event_type: 'session_start',\n        timestamp: localISO(startTime)\n    };\n\n    statusMsg = { payload: { event_type: 'sat' } };\n\n    var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n    var dayOfWeek = dayNames[new Date(startTime).getDay()];\n\n    // INSERT нов \"отворен\" ред, session_end = NULL\n    insertMsg = {\n        payload: {\n            mode: 'start',\n            session_start: localISO(startTime),\n            day_of_week: dayOfWeek\n        }\n    };\n} else {\n    // КРАЙ на сесия\n    var lastChangeTime = flow.get('lastChangeTime') || Date.now();\n    var lastState = flow.get('deskState') || 'stood';\n    var finalDuration = Math.floor((Date.now() - lastChangeTime) / 1000);\n\n    if (lastState === 'sat') {\n        flow.set('sessionSatSeconds', (flow.get('sessionSatSeconds') || 0) + finalDuration);\n    } else {\n        flow.set('sessionStoodSeconds', (flow.get('sessionStoodSeconds') || 0) + finalDuration);\n    }\n\n    flow.set('sessionActive', false);\n    flow.set('deskState', 'stood');\n\n    var totalSat = flow.get('sessionSatSeconds') || 0;\n    var totalStood = flow.get('sessionStoodSeconds') || 0;\n    var sessionStart = flow.get('sessionStartTime') || Date.now();\n    var sessionEndTime = Date.now();\n    var totalSeconds = Math.floor((sessionEndTime - sessionStart) / 1000);\n\n    msg.payload = {\n        event_type: 'session_end',\n        total_sat_seconds: totalSat,\n        total_stood_seconds: totalStood,\n        total_session_seconds: totalSeconds,\n        timestamp: localISO(Date.now())\n    };\n\n    statusMsg = { payload: { event_type: 'stood' } };\n\n    // UPDATE отворения ред, попълва session_end + totals\n    insertMsg = {\n        payload: {\n            mode: 'end',\n            session_start: localISO(sessionStart),\n            session_end: localISO(sessionEndTime),\n            total_sat_seconds: totalSat,\n            total_stood_seconds: totalStood,\n            total_session_seconds: totalSeconds\n        }\n    };\n}\n\nreturn [msg, statusMsg, insertMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
