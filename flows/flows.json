    {
        "id": "e1b79d3ae6349fce",
        "type": "function",
        "z": "fb8178f3789d4b3d",
        "name": "Toggle Logic",
        "func": "// локално време (Europe/Sofia) като ISO низ БЕЗ Z — Postgres го записва буквално\nfunction localISO(ms) {\n    var d = new Date(ms);\n    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, -1);\n}\n\n// прочети текущото състояние от flow context\nvar currentState = flow.get('deskState') || 'stood';\nvar lastChangeTime = flow.get('lastChangeTime') || Date.now();\n\n// изчисли продължителността на предишното състояние (в секунди)\nvar durationSeconds = Math.floor((Date.now() - lastChangeTime) / 1000);\n\n// toggle към ново състояние\nvar newState = (currentState === 'stood') ? 'sat' : 'stood';\n\n// запази новото състояние + нов старт час\nflow.set('deskState', newState);\nflow.set('lastChangeTime', Date.now());\n\n// трупай времето в running totals, САМО ако работна сесия тече в момента\nvar sessionActive = flow.get('sessionActive') || false;\nif (sessionActive) {\n    if (currentState === 'sat') {\n        flow.set('sessionSatSeconds', (flow.get('sessionSatSeconds') || 0) + durationSeconds);\n    } else {\n        flow.set('sessionStoodSeconds', (flow.get('sessionStoodSeconds') || 0) + durationSeconds);\n    }\n}\n\n// съобщение 1 — за live dashboard (текущ статус, показва НОВОТО състояние)\nvar liveMsg = {\n    payload: {\n        event_type: newState,\n        timestamp: localISO(Date.now())\n    }\n};\n\n// съобщение 2 — за INSERT (завършената сесия, ПРЕДИШНОТО състояние + продължителност)\nvar insertMsg = {\n    payload: {\n        event_type: currentState,\n        duration_seconds: durationSeconds,\n        timestamp: localISO(lastChangeTime)\n    }\n};\n\nreturn [liveMsg, insertMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
