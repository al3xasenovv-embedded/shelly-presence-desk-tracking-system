    {
        "id": "724e90d9d1fb776a",
        "type": "function",
        "z": "fb8178f3789d4b3d",
        "name": "Build Work Session Insert ",
        "func": "if (msg.payload.mode === 'start') {\n    msg.query = \"INSERT INTO work_sessions (session_start, session_end, day_of_week) VALUES ($1, NULL, $2) RETURNING id\";\n    msg.params = [msg.payload.session_start, msg.payload.day_of_week];\n} else {\n    var workSessionId = flow.get('currentWorkSessionId');\n    msg.query = \"UPDATE work_sessions SET session_end = $1, total_sat_seconds = $2, total_stood_seconds = $3, total_session_seconds = $4 WHERE id = $5\";\n    msg.params = [\n        msg.payload.session_end,\n        msg.payload.total_sat_seconds,\n        msg.payload.total_stood_seconds,\n        msg.payload.total_session_seconds,\n        workSessionId\n    ];\n}\nreturn msg;",
